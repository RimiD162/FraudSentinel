# FraudSentinel Backend Environment Variables
DATABASE_URL=sqlite:///./fraudsentinel.db
DB_ECHO=false

# Supabase Authentication
# Set to your Supabase project URL (e.g., https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project.supabase.co
# Optional: Supabase JWT Secret if project signs with HS256
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-optional
