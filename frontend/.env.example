# ===================================================
# FraudSentinel — Frontend Environment Variables Template
# ===================================================
# Copy this file to .env and adjust values as needed:
#   cp .env.example .env

# Application Metadata
VITE_APP_NAME="FraudSentinel 🛡️"
VITE_APP_TITLE="FraudSentinel - AI-Powered Fraud Detection & Risk Analytics"
VITE_APP_ENV=development

# API & Gateway Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_API_TIMEOUT=15000

# Supabase Authentication Configuration
# Provide your Supabase project URL and client publishable/anon key.
# NEVER place service_role keys or database secrets here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key

# Access Control & Demo Mode
# Roles are strictly determined server-side (admin, analyst, viewer).
VITE_ENABLE_DEMO_MODE=false

# Feature Flags & Simulation Parameters
VITE_ENABLE_ML_SIMULATION=true
VITE_ENABLE_REALTIME_STREAM=true
VITE_MOCK_DATA_REFRESH_INTERVAL=5000

# Development Server
VITE_PORT=5173
