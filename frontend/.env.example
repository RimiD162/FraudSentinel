# ===================================================
# FraudSentinel — Frontend Environment Variables Template
# ===================================================
# Copy this file to .env and adjust values as needed:
#   cp .env.example .env

# Application Metadata
VITE_APP_NAME="FraudSentinel 🛡️"
VITE_APP_TITLE="FraudSentinel - AI-Powered Fraud Detection & Risk Analytics"
VITE_APP_ENV=development

# API & Gateway Configuration (Placeholder for backend integration)
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_API_TIMEOUT=15000

# Role & Access Control (Demo Configuration)
# Options: admin | analyst | viewer
VITE_DEFAULT_ROLE=admin
VITE_ENABLE_DEMO_MODE=true

# Feature Flags & Simulation Parameters
VITE_ENABLE_ML_SIMULATION=true
VITE_ENABLE_REALTIME_STREAM=true
VITE_MOCK_DATA_REFRESH_INTERVAL=5000

# Development Server
VITE_PORT=5173
